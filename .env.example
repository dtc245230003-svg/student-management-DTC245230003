# Sao chép thành .env rồi thay bằng mật khẩu mạnh (xem README)
MYSQL_ROOT_PASSWORD=doi_mat_khau_root
DB_NAME=studentdb
DB_USER=student_app
DB_PASSWORD=doi_mat_khau_app

# IP hoặc tên miền người dùng dùng để truy cập hệ thống (dùng cho URL của Grafana/Prometheus)
SERVER_IP=192.168.44.131

# Tài khoản quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi_mat_khau_grafana

# Tài khoản DB riêng cho mysqld-exporter (quyền tối thiểu, KHÔNG dùng root)
EXPORTER_DB_USER=exporter
EXPORTER_DB_PASSWORD=doi_mat_khau_exporter
