<%- include('../partials/header', { title }) %>
<div class="bar"><h1>Sinh viên</h1><a class="btn primary" href="/students/new">Thêm sinh viên</a></div>
<%- include('../partials/flash', { msg, err }) %>
<% if (!rows.length) { %><p class="muted">Chưa có sinh viên nào. Chọn “Thêm sinh viên” để bắt đầu.</p><% } else { %>
<table>
  <thead><tr><th>Mã SV</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function(r){ %>
    <tr>
      <td><%= r.student_code %></td><td><%= r.full_name %></td><td><%= r.email %></td><td><%= r.class_code %></td>
      <td class="actions">
        <a class="btn" href="/students/<%= r.id %>/edit">Sửa</a>
        <form method="post" action="/students/<%= r.id %>/delete" data-confirm="Xóa sinh viên <%= r.student_code %> và toàn bộ điểm?"><button class="btn danger">Xóa</button></form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
