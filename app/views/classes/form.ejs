<%- include('../partials/header', { title }) %>
<h1><%= title %></h1>
<%- include('../partials/errors', { errors }) %>
<form method="post" action="<%= action %>" class="card">
  <label>Mã lớp <input name="class_code" value="<%= item.class_code || '' %>" maxlength="20" required></label>
  <label>Tên lớp <input name="class_name" value="<%= item.class_name || '' %>" maxlength="100" required></label>
  <div class="row"><button class="btn primary">Lưu lớp</button><a class="btn" href="/classes">Hủy</a></div>
</form>
<%- include('../partials/footer') %>
